% Objective: minimize number of colors used for the mandala graph.

set of int: REGIONS = {0, 1, 2, 3, 4, 5, 6};
int: REGION_COUNT = 7;
int: EDGE_COUNT = 6;

array[REGIONS] of var 1..REGION_COUNT: color;
var 1..REGION_COUNT: max_color;

array[1..EDGE_COUNT] of int: edge_u = [1, 1, 2, 3, 4, 5];
array[1..EDGE_COUNT] of int: edge_v = [2, 3, 4, 5, 6, 6];

